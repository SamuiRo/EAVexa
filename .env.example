# EAVexa configuration — copy to .env and adjust as needed.
# Every variable has a working default; nothing here is required to run.

# Explicit Chrome/Chromium binary. Leave unset to use Playwright's bundled Chromium.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Sandbox mode: auto | on | off
# auto (default) disables --no-sandbox unless running inside a container
# (detected via /.dockerenv). Set "off" only if you must disable the sandbox
# on a bare-metal host; set "on" to force the sandbox even in a container.
CHROME_SANDBOX=auto

# Explicit FFmpeg binary. Leave unset to use the bundled ffmpeg-static binary.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Max time (ms) to wait for the page's network activity to settle before
# rendering proceeds anyway. Prevents a dead CDN / polling template from
# hanging forever.
NETWORK_TIMEOUT_MS=15000

# Max time (ms) to wait for document.fonts.ready before rendering with
# whatever fonts are loaded so far.
FONT_TIMEOUT_MS=5000

# Where async job records live (one JSON file per job, under a per-day folder).
# JOB_STORE_DIR=./data/jobs

# How many job records to keep in memory (LRU). Older ones are re-read from disk.
JOB_CACHE_SIZE=500

# HMAC secret for the X-EAVexa-Signature webhook header. Leave unset to skip
# signing (a warning is logged) — fine for a purely internal n8n instance.
# WEBHOOK_SECRET=

# Delivery attempts before a webhook is marked permanently failed.
WEBHOOK_MAX_ATTEMPTS=5

# Per-attempt HTTP timeout (ms).
WEBHOOK_TIMEOUT_MS=10000

# Allow webhook URLs pointing at localhost/private networks (the common case
# for n8n running on the same host or LAN). Set to "false" to require public hosts.
WEBHOOK_ALLOW_PRIVATE=true

# Optional strict allowlist (comma-separated hostnames) for webhook URLs.
# WEBHOOK_ALLOWED_HOSTS=

# HTTP server (eavexa serve).
EAVEXA_PORT=8080
EAVEXA_HOST=127.0.0.1

# If set, all /v1/* requests require a matching X-API-Key header. Unset means
# open access — fine for localhost-only use, documented as a deliberate
# trade-off (see docs/api.md).
# EAVEXA_API_KEY=

# How the server's own URL is presented back in result.url/poll_url when the
# incoming request's Host header isn't reliable (behind a proxy, in a
# container). Leave unset to use Host / X-Forwarded-* from the request.
# EAVEXA_PUBLIC_URL=http://eavexa.internal:8080

# Max request body size in MB (POST /v1/render with an inline template etc.).
MAX_BODY_MB=10

# How long the server waits for in-flight renders to finish on SIGTERM/SIGINT
# before closing the browser pool and exiting anyway.
SHUTDOWN_GRACE_MS=30000

# Window during which a repeated request with the same Idempotency-Key header
# returns the original job instead of rendering again.
IDEMPOTENCY_TTL_MS=600000

# HMAC secret for signed one-time ?token= links on GET /v1/jobs/:id/result,
# so a result URL can be shared without the main X-API-Key. Leave unset to
# disable — the endpoint then always requires the main key (or is open, if
# EAVEXA_API_KEY isn't set either).
# RESULT_TOKEN_SECRET=
