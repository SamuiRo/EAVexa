# EAVexa configuration — copy to .env and adjust as needed.
# Every variable has a working default; nothing here is required to run.

# Explicit Chrome/Chromium binary. Leave unset to use Playwright's bundled Chromium.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Sandbox mode: auto | on | off
# auto (default) disables --no-sandbox unless running inside a container
# (detected via /.dockerenv). Set "off" only if you must disable the sandbox
# on a bare-metal host; set "on" to force the sandbox even in a container.
CHROME_SANDBOX=auto

# Explicit FFmpeg binary. Leave unset to use the bundled ffmpeg-static binary.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Max time (ms) to wait for the page's network activity to settle before
# rendering proceeds anyway. Prevents a dead CDN / polling template from
# hanging forever.
NETWORK_TIMEOUT_MS=15000

# Max time (ms) to wait for document.fonts.ready before rendering with
# whatever fonts are loaded so far.
FONT_TIMEOUT_MS=5000
