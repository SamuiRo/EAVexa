# EAVexa configuration — copy to .env and adjust as needed.
# Every variable has a working default; nothing here is required to run.
# Full reference with defaults: docs/specification.md §10.

# ─── Paths ────────────────────────────────────────────────────────────────────

# Root for all runtime data (outputs, job records, user templates, logs).
# Everything below defaults to a folder inside it.
# DATA_DIR=./data

# Where rendered artifacts are written, as <OUTPUT_DIR>/<YYYY-MM-DD>/<job_id>/<file>.
# OUTPUT_DIR=./data/outputs

# The path a *consumer* should use to reach OUTPUT_DIR, when it differs from the
# real one — e.g. EAVexa runs on the host but n8n reads the same files from
# inside a container. result.path is rewritten to this prefix; result.local_path
# always keeps the real one. Leave unset when both sides see the same path.
# OUTPUT_DIR_ALIAS=/data/outputs

# User templates (override built-ins of the same name).
# TEMPLATES_DIR=./data/templates

# Built-in templates shipped with the app. Only change this if you relocate them.
# BUILTIN_TEMPLATES_DIR=./templates

# Scratch space for video frame sequences. Defaults to the OS temp dir on
# purpose — frames are large and short-lived, and must not land in OUTPUT_DIR.
# TMP_DIR=/tmp

# ─── Chromium / FFmpeg ────────────────────────────────────────────────────────

# Explicit Chrome/Chromium binary. Leave unset to use Playwright's bundled Chromium.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Sandbox mode: auto | on | off
# auto (default) disables --no-sandbox unless running inside a container
# (detected via /.dockerenv). Set "off" only if you must disable the sandbox
# on a bare-metal host; set "on" to force the sandbox even in a container.
CHROME_SANDBOX=auto

# Explicit FFmpeg binary. Leave unset to use the bundled ffmpeg-static binary.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Restart the browser after this many renders, to bound memory growth.
# The restart waits for in-flight renders to finish first.
BROWSER_MAX_RENDERS=200

# Max time (ms) to wait for the page's network activity to settle before
# rendering proceeds anyway. Prevents a dead CDN / polling template from
# hanging forever.
NETWORK_TIMEOUT_MS=15000

# Max time (ms) to wait for document.fonts.ready before rendering with
# whatever fonts are loaded so far.
FONT_TIMEOUT_MS=5000

# ─── Queue and render limits ──────────────────────────────────────────────────

# Independent concurrency lanes. Videos get their own so one long encode can't
# block a queue of fast image renders.
RENDER_CONCURRENCY=3
VIDEO_CONCURRENCY=1

# Queued + running renders allowed before new requests are rejected with
# 503 QUEUE_FULL and a Retry-After header.
QUEUE_MAX=100

# Wall-clock ceiling for a single render.
RENDER_TIMEOUT_MS=60000

# Cost (in frames) above which a request is forced async even without a
# callback_url, so an HTTP connection never hangs for minutes. An image is
# 1 frame; 90 is roughly 3 seconds of 30fps video.
SYNC_MAX_COST=90

# Hard ceilings — a request exceeding any of these fails with LIMIT_EXCEEDED.
MAX_WIDTH=4096
MAX_HEIGHT=4096
MAX_VIDEO_DURATION=60
MAX_FPS=60
MAX_FRAMES=3600

# ─── Job store ────────────────────────────────────────────────────────────────

# Where async job records live (one JSON file per job, under a per-day folder).
# JOB_STORE_DIR=./data/jobs

# How many job records to keep in memory (LRU). Older ones are re-read from disk.
JOB_CACHE_SIZE=500

# How far back startup recovery looks when re-arming interrupted jobs and
# pending webhook retries. Job records are never deleted by default, so an
# unbounded scan would grow with total history. Raise this if a job may sit
# undelivered longer than the window; a job older than it is never resumed.
JOB_RECOVERY_WINDOW_DAYS=7

# ─── Webhooks ─────────────────────────────────────────────────────────────────

# HMAC secret for the X-EAVexa-Signature webhook header. Leave unset to skip
# signing (a warning is logged) — fine for a purely internal n8n instance.
# WEBHOOK_SECRET=

# Delivery attempts before a webhook is marked permanently failed.
WEBHOOK_MAX_ATTEMPTS=5

# Per-attempt HTTP timeout (ms).
WEBHOOK_TIMEOUT_MS=10000

# Allow webhook URLs pointing at localhost/private networks (the common case
# for n8n running on the same host or LAN). Set to "false" to require public hosts.
WEBHOOK_ALLOW_PRIVATE=true

# Optional strict allowlist (comma-separated hostnames) for webhook URLs.
# WEBHOOK_ALLOWED_HOSTS=

# Size ceiling for inlining a base64 artifact into a webhook body. Above it an
# async result degrades to a link (result.data=null, downgraded_from="base64")
# so the payload can't blow past the receiver's body limit — n8n's default is
# ~16MB. Synchronous responses are never degraded.
CALLBACK_INLINE_MAX_BYTES=262144

# ─── HTTP server (eavexa serve) ───────────────────────────────────────────────

EAVEXA_PORT=8080
EAVEXA_HOST=127.0.0.1

# If set, all /v1/* requests require a matching X-API-Key header. Unset means
# open access — fine for localhost-only use, documented as a deliberate
# trade-off (see docs/api.md).
# EAVEXA_API_KEY=

# How the server's own URL is presented back in result.url/poll_url when the
# incoming request's Host header isn't reliable (behind a proxy, in a
# container). Leave unset to use Host / X-Forwarded-* from the request.
# EAVEXA_PUBLIC_URL=http://eavexa.internal:8080

# Max request body size in MB (POST /v1/render with an inline template etc.).
MAX_BODY_MB=10

# How long the server waits for in-flight renders to finish on SIGTERM/SIGINT
# before closing the browser pool and exiting anyway.
SHUTDOWN_GRACE_MS=30000

# Window during which a repeated request with the same Idempotency-Key header
# returns the original job instead of rendering again.
IDEMPOTENCY_TTL_MS=600000

# HMAC secret for signed one-time ?token= links on GET /v1/jobs/:id/result,
# so a result URL can be shared without the main X-API-Key. Leave unset to
# disable — the endpoint then always requires the main key (or is open, if
# EAVEXA_API_KEY isn't set either).
# RESULT_TOKEN_SECRET=

# ─── Templates ────────────────────────────────────────────────────────────────

# Allowlist (comma-separated hostnames) for fetching a template by URL.
# Unset means any host is allowed — set this if untrusted input can reach
# source.url, since it is an outbound request EAVexa makes on the caller's behalf.
# TEMPLATE_ALLOWED_HOSTS=

# ─── Logging ──────────────────────────────────────────────────────────────────

# pretty (human, coloured) | json (one structured event per line).
# Always written to stderr — stdout is reserved for command results.
LOG_FORMAT=pretty

# debug | info | warn | error
LOG_LEVEL=info
