{
  "name": "eavexa",
  "version": "2.1.2",
  "description": "Render HTML templates to PNG images and MP4/WebM/MOV/MKV videos, via CLI, HTTP API, or a jobs.json batch runner",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "eavexa": "src/cli/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "templates",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "serve": "node src/cli/cli.js serve",
    "render": "node src/cli/cli.js render",
    "doctor": "node src/cli/cli.js doctor",
    "templates": "node src/cli/cli.js templates",
    "formats": "node src/cli/cli.js formats",
    "jobs": "node src/cli/cli.js jobs",
    "lint": "node scripts/check_syntax.mjs",
    "test": "node scripts/run_tests.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuiRo/EAVexa.git"
  },
  "keywords": [],
  "author": "StarLith",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/SamuiRo/EAVexa/issues"
  },
  "homepage": "https://github.com/SamuiRo/EAVexa#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "gradient-string": "^3.0.0",
    "playwright": "^1.60.0"
  }
}
